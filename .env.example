# Copy to .env.local. Values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only: reading receipts with Claude (Claude Console > API keys)
ANTHROPIC_API_KEY=

# Server only: payments (Stripe dashboard > Developers > API keys; start with the test keys).
# Without STRIPE_SECRET_KEY the site works as before payment existed.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=
# Server only: lets the Stripe webhook update a garage's plan (Supabase > Project Settings > API Keys > Secret key).
SUPABASE_SECRET_KEY=
